# For details on each environment variable, see
# https://healthchecks.io/docs/self_hosted_configuration/

# gunicorn
GUNICORN_WORKERS=4
# The HTTP listening port. When changing, remember to change the exported
# port in docker-compose.yml as well.
GUNICORN_PORT=8000
# Set to "1" to disable access log to container's stdout
GUNICORN_DISABLE_LOGGING=
# Set to "1" to enable listening on both IPv4 and IPv6
LISTEN_IPV6=

# Admin email addresses (admins receive error emails when DEBUG=False)
ADMINS=

# Database
DB=postgres
DB_CONN_MAX_AGE=0
DB_HOST=db
DB_NAME=hc
DB_PASSWORD=fixme-postgres-password
DB_PORT=5432
DB_SSLMODE=prefer
DB_TARGET_SESSION_ATTRS=read-write
DB_USER=postgres

# Debug mode. Never run a Healthchecks instance in production with the debug mode
# turned on!
DEBUG=False

# For sending email
DEFAULT_FROM_EMAIL=healthchecks@example.org
EMAIL_HOST=
EMAIL_HOST_PASSWORD=
EMAIL_HOST_USER=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_VERIFICATION=True

# Whether integrations are allowed to make HTTP requests
# to private IP addresses
INTEGRATIONS_ALLOW_PRIVATE_IPS=False

# The upper size limit in bytes for logged ping request bodies
# (larger request bodes are truncated at the end).
PING_BODY_LIMIT=10000
# The domain to use for generating ping email addresses.
PING_EMAIL_DOMAIN=localhost
# The base URL to use for constructing ping URLs for display.
PING_ENDPOINT=http://localhost:8000/ping/
# Whether site visitors can create new accounts
REGISTRATION_OPEN=True
# Enables external authentication. See
# https://healthchecks.io/docs/self_hosted_configuration/#REMOTE_USER_HEADER
REMOTE_USER_HEADER=
# The Relying Party identifier, required by the WebAuthn second-factor
# authentication feature.
RP_ID=

# S3 credentials for offloading ping bodies
S3_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_SECRET_KEY=
S3_TIMEOUT=60
S3_SECURE=True

# A secret key used for cryptographic signing. Should be set to a unique,
# unpredictable value.
SECRET_KEY=---
# An URL pointing to the image you want to use as the site logo.
SITE_LOGO_URL=
# The display name of this Healthchecks instance.
SITE_NAME=Mychecks
# The base URL of this Healthchecks instance.
SITE_ROOT=http://localhost:8000
# The port for the SMTP listener. If empty then SMTP listener does not run.
SMTPD_PORT=

# Integrations
APPRISE_ENABLED=False
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_PUBLIC_LINK=
MATRIX_ACCESS_TOKEN=
MATRIX_HOMESERVER=
MATRIX_USER_ID=
MATTERMOST_ENABLED=True
MSTEAMS_ENABLED=True
NTFY_SH_TOKEN=
OPSGENIE_ENABLED=True
PAGERTREE_ENABLED=True
PD_APP_ID=
PD_ENABLED=True
PROMETHEUS_ENABLED=True
PUSHBULLET_CLIENT_ID=
PUSHBULLET_CLIENT_SECRET=
PUSHOVER_API_TOKEN=
PUSHOVER_EMERGENCY_EXPIRATION=86400
PUSHOVER_EMERGENCY_RETRY_DELAY=300
PUSHOVER_SUBSCRIPTION_URL=
ROCKETCHAT_ENABLED=True
SHELL_ENABLED=False
SIGNAL_CLI_SOCKET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_ENABLED=True
SPIKE_ENABLED=True
TELEGRAM_BOT_NAME=ExampleBot
TELEGRAM_TOKEN=
TRELLO_APP_KEY=
TWILIO_ACCOUNT=
TWILIO_AUTH=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_USE_WHATSAPP=False
VICTOROPS_ENABLED=True
WEBHOOKS_ENABLED=True
WHATSAPP_DOWN_CONTENT_SID=
WHATSAPP_UP_CONTENT_SID=
ZULIP_ENABLED=True
